{
  "test_cases": [
    {
      "operation_id": "Payroll_listPayrollOutputs",
      "test_type": "happy_path",
      "path_params": {},
      "query_params": {
        "$filter": "payrollScheduleReference/payrollYear eq 2023 and payrollScheduleReference/payrollWeekNumber eq 12 and payrollGroupCode/codeValue eq %26Y%26 and payrollRegionCode/codeValue eq BALT",
        "$count": "true",
        "use-cache": "false",
        "level": "details",
        "$select": "earnings,reportableEarningsAndBenefits"
      },
      "headers": {},
      "json_body": null,
      "expected_statuses": [
        200
      ],
      "expected_response_summary": "Returns a list of payroll outputs for the specified region, company code, year, and week with selected fields.",
      "notes": "Valid filter and select parameters; expects normal data payload."
    },
    {
      "operation_id": "Payroll_listPayrollOutputs",
      "test_type": "negative_validation",
      "path_params": {},
      "query_params": {
        "$filter": "payrollScheduleReference/payrollYear eq 9999 and payrollScheduleReference/payrollWeekNumber eq 99 and payrollGroupCode/codeValue eq INVALID and payrollRegionCode/codeValue eq NONE",
        "$count": "true",
        "use-cache": "false",
        "level": "details",
        "$select": "earnings"
      },
      "headers": {},
      "json_body": null,
      "expected_statuses": [
        200,
        400,
        404
      ],
      "expected_response_summary": "Returns empty result set or error for invalid filter values.",
      "notes": "Boundary test for filter values that likely do not exist."
    },
    {
      "operation_id": "Hr_listTop5PreventCache",
      "test_type": "happy_path",
      "path_params": {},
      "query_params": {
        "$top": "5",
        "preventCache": "20240601T120000Z",
        "$filter": "workers/workAssignments/homeOrganizationalUnits/typeCode/codeValue eq 'Department' and workers/workAssignments/homeOrganizationalUnits/nameCode/codeValue eq '001000'"
      },
      "headers": {},
      "json_body": null,
      "expected_statuses": [
        200
      ],
      "expected_response_summary": "Returns top 5 workers matching filter, cache-busting applied.",
      "notes": "Standard use with cache prevention and filter."
    },
    {
      "operation_id": "Hr_listTop5PreventCache",
      "test_type": "boundary",
      "path_params": {},
      "query_params": {
        "$top": "0",
        "preventCache": "20240601T120000Z",
        "$filter": ""
      },
      "headers": {},
      "json_body": null,
      "expected_statuses": [
        200,
        400
      ],
      "expected_response_summary": "Returns empty list or error for $top=0.",
      "notes": "Boundary test for minimum $top value."
    },
