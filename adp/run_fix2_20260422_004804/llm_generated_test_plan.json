{
  "test_cases": [
    {
      "operation_id": "Payroll_listPayrollOutputs",
      "test_type": "happy_path",
      "path_params": {},
      "query_params": {
        "$filter": "payrollScheduleReference/payrollYear eq 2023 and payrollScheduleReference/payrollWeekNumber eq 15 and payrollGroupCode/codeValue eq %26Y%26 and payrollRegionCode/codeValue eq BALT",
        "$count": "true",
        "use-cache": "false",
        "level": "details",
        "$select": "earnings,reportableEarningsAndBenefits"
      },
      "headers": {},
      "json_body": null,
      "expected_statuses": [
        200
      ],
      "expected_response_summary": "Returns a list of payroll outputs for the specified region, company code, year, and week with selected fields.",
      "notes": "Valid filter and select parameters, expecting normal output."
    },
    {
      "operation_id": "Payroll_listPayrollOutputs",
      "test_type": "negative_validation",
      "path_params": {},
      "query_params": {
        "$filter": "payrollScheduleReference/payrollYear eq 2023 and payrollScheduleReference/payrollWeekNumber eq 9999 and payrollGroupCode/codeValue eq %26Y%26 and payrollRegionCode/codeValue eq BALT",
        "$count": "true",
        "use-cache": "false",
        "level": "details",
        "$select": "earnings"
      },
      "headers": {},
      "json_body": null,
      "expected_statuses": [
        200,
        400
      ],
      "expected_response_summary": "Returns empty list or error for invalid week number.",
      "notes": "Boundary test for week number; expect empty result or error."
    },
    {
      "operation_id": "Hr_listTop5PreventCache",
      "test_type": "happy_path",
      "path_params": {},
      "query_params": {
        "$top": "5",
        "preventCache": "20240601T120000Z",
        "$filter": "workers/workAssignments/homeOrganizationalUnits/typeCode/codeValue eq 'Department' and workers/workAssignments/homeOrganizationalUnits/nameCode/codeValue eq '001000'"
      },
      "headers": {},
      "json_body": null,
      "expected_statuses": [
        200
      ],
      "expected_response_summary": "Returns top 5 workers matching filter, cache-buster prevents cached response.",
      "notes": "Standard use case with filter and cache prevention."
    },
    {
      "operation_id": "Hr_listTop5PreventCache",
      "test_type": "boundary",
      "path_params": {},
      "query_params": {
        "$top": "0",
        "preventCache": "20240601T120000Z",
        "$filter": ""
      },
      "headers": {},
      "json_body": null,
      "expected_statuses": [
        200,
        400
      ],
      "expected_response_summary": "Returns empty list or error for $top=0.",
      "notes": "Boundary test for $top parameter."
    },
