# OpenAI-compatible settings
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Azure OpenAI (optional; when endpoint+key are set, these are used)
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_DEPLOYMENT=your_azure_deployment_name
AZURE_OPENAI_API_VERSION=2025-01-01-preview
MODEL=your_azure_deployment_name
API_VERSION=2025-01-01-preview

# Runtime settings
DEFAULT_TIMEOUT=10
MAX_SELECTED_OPERATIONS=0
MODE=quick
MAX_LLM_VALIDATION_ITERATIONS=2
FIXTURE_BOOTSTRAP=true
FIXTURE_BOOTSTRAP_MAX_PROBES=25
AUTH_SCHEME_ALLOWLIST=
INCLUDE_AUTH_CONTRAST=true
EXCLUDE_PATH_PREFIXES=

# Optional bearer token for authenticated APIs
AUTH_TOKEN=your_api_token_here
